---
interface Props {
  active: "home" | "blog" | "stats";
}
const { active } = Astro.props;
---

<div class="tabbar">
  <a class="tab" class:list={[{ active: active === "home" }]} href="/">
    <span class="dot"></span>~/lambiengcode
  </a>
  <a class="tab" class:list={[{ active: active === "blog" }]} href="/blog/">
    <span class="dot"></span>blog/
  </a>
  <a class="tab" class:list={[{ active: active === "stats" }]} href="/stats/">
    <span class="dot"></span>stats/
  </a>
  <div class="tabbar-fill"></div>
</div>
